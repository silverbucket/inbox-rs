# Dependencies
node_modules/

# Build artifacts — never commit these for normal development.
# For deployment, the release workflow uses `git add -f` to force-add
# packages/web/dist/ for the 5apps subtree-push, then the deploy commit
# is pushed only to the 5apps remote, never to origin/master.
dist/
packages/web/src/lib/plugin-downloads.generated.ts

# Environment & secrets
.env
*.local

# Local dev data
rs-data/

# Editor / OS
.context/
.DS_Store

# Per-developer Claude Code overrides. The `*.local` pattern above
# doesn't match `*.local.json`, so list explicitly. Project-wide
# `.claude/settings.json` IS committed — only the personal override
# file is private.
.claude/settings.local.json
.claude/settings.local*.json

# Extension build outputs (already covered by dist/, listed explicitly for clarity)
*.xpi

# Source-archive tarballs produced for Firefox AMO / Mozilla addon review.
# Generated on demand; never tracked.
packages/*/inbox-rs-src.tar.gz

# Dev-only download staging area (copied into dist/ during build)
packages/web/public/downloads/
packages/web/public/ml/

# End-to-end test artefacts (see tests/e2e/README.md)
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/blob-report/

# Local-only design mockups (not part of the app or build)
mockups/
