{
  "name": "inbox-rs",
  "version": "2.6.9",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "scripts",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "vendor:transcription-assets": "bun run --cwd packages/web vendor:transcription-assets",
    "vendor:transcription-assets:refresh": "bun run --cwd packages/web vendor:transcription-assets:refresh",
    "package:plugins": "node scripts/package-plugins.mjs",
    "build:extension": "bun run --cwd packages/extension build",
    "build:thunderbird": "bun run --cwd packages/thunderbird build",
    "test": "bun run --cwd packages/rs-module test && bun run --cwd packages/extension test && bun run --cwd packages/thunderbird test && bun run --cwd packages/web test && bun run --cwd scripts test",
    "test:e2e": "bun run --cwd tests/e2e test",
    "test:e2e:install": "bun run --cwd tests/e2e test:install",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "package:thunderbird": "node scripts/package-thunderbird.mjs",
    "package:submissions": "node scripts/package-submissions.mjs",
    "package:browsers": "node scripts/package-submissions.mjs chromium firefox",
    "check:submissions": "node scripts/check-submissions.mjs",
    "test:extensions": "node scripts/test-extensions.mjs",
    "screenshots:thunderbird": "node scripts/capture-thunderbird-screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13"
  },
  "overrides": {
    "protobufjs": "^8.8.1",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0"
  }
}
